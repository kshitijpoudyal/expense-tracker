# Copy to .env.local for local development. The same names go into Vercel (Project Settings → Environment
# Variables) and, for the EXPO_PUBLIC_ ones, into EAS for the Android build.

# --- App (public; safe to ship in the app) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Where the /api functions live. Defaults to the same origin on web and the production site on Android.
# EXPO_PUBLIC_API_URL=https://expense.kshitijstudio.com

# --- Server only (Vercel). Never prefix these with EXPO_PUBLIC_. ---
SUPABASE_SECRET_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional. Needed for banks that sign in through OAuth; must also be added in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://expense.kshitijstudio.com
# Optional. Defaults to com.kay.money.
# PLAID_ANDROID_PACKAGE_NAME=com.kay.money
